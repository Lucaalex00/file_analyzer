# Leave everything below empty to run in demo mode (simulated AI
# explanations, real extraction/red-flags/PDF generation, no credentials
# needed). Fill in the Azure OpenAI block for real AI-written explanations;
# if that's not available, GROQ_API_KEY alone also works (free, no card,
# OpenAI-compatible -- see https://console.groq.com). Azure OpenAI takes
# priority if both are set.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Must be a deployment name that actually exists on your Azure OpenAI
# resource -- check "Model deployments" in Azure AI Foundry, since the
# available model catalog changes over time.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MAX_FILE_SIZE_BYTES=10485760
RATE_LIMIT_PER_MINUTE=20
MAX_BATCH_FILES=5
REPORT_BRAND_NAME=File Analyzer
REPORT_ACCENT_COLOR=#2563eb
