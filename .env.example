# Leave both empty to run in demo mode (simulated AI explanations, real
# extraction/red-flags/PDF generation, no credentials needed). Fill them in
# with a real Azure OpenAI resource to get real AI-written explanations.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
MAX_FILE_SIZE_BYTES=10485760
RATE_LIMIT_PER_MINUTE=20
MAX_BATCH_FILES=5
REPORT_BRAND_NAME=File Analyzer
REPORT_ACCENT_COLOR=#2563eb
